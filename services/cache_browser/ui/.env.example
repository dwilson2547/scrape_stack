# Upstream service hostnames and ports for nginx proxy.
# These defaults match the docker-compose service names — only override if different.

NGINX_RESOLVER=127.0.0.11
API_HOST=cache-browser-api
API_PORT=8040
WEBCACHE_HOST=webcache
WEBCACHE_PORT=8000
IMGCACHE_HOST=imgcache
IMGCACHE_PORT=8010
FILECACHE_HOST=filecache
FILECACHE_PORT=8030
VIDCACHE_HOST=vidcache
VIDCACHE_PORT=8020
