# Storage backend: "local" or "s3"
STORAGE_BACKEND=local

# --- Local storage ---
LOCAL_STORAGE_PATH=/data/cache

# --- Database ---
DATABASE_URL=sqlite:////data/webcache.db

# --- S3 / MinIO (only needed when STORAGE_BACKEND=s3) ---
S3_BUCKET=webcache
S3_ENDPOINT_URL=          # leave blank for AWS; set to http://localhost:9000 for MinIO
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Browserless (used by /render endpoint) ---
BROWSERLESS_URL=http://browserless:3000
BROWSERLESS_TOKEN=        # optional

# --- OpenTelemetry metrics (leave blank to disable export) ---
OTEL_EXPORTER_OTLP_ENDPOINT=   # e.g. http://otel-collector:4318
OTEL_SERVICE_NAME=webcache
